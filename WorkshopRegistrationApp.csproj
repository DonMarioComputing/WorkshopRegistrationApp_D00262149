<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--An ASP.NET Core web application using .NET 8-->
    <TargetFramework>net8.0</TargetFramework>

    <!--Automatically import common ASP.NET Core namespaces-->
    <ImplicitUsings>enable</ImplicitUsings>

    <!--Warn when code uses a possibly null value incorrectly-->
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
